import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")
import("../../../scripts/build/typescript/typescript.gni")
import("../visibility.gni")

generate_css("css_files") {
  sources = [ "styleIntelligencePane.css" ]
}

devtools_ui_module("style_intelligence") {
  sources = [
    "Diagnostics.ts",
    "ElementSummary.ts",
    "LayeringPresentation.ts",
    "LayoutExplanation.ts",
    "LayoutRelationships.ts",
    "LayoutRelationshipsLoader.ts",
    "LayoutRelationshipsPresentation.ts",
    "Presentation.ts",
    "SpacingExplanation.ts",
    "StackingBoundary.ts",
    "StackingChain.ts",
    "StackingChainLoader.ts",
    "StackingReasons.ts",
    "StackingSnapshot.ts",
    "StyleIntelligenceModel.ts",
    "StyleIntelligencePane.ts",
  ]

  deps = [
    "../../core/common:bundle",
    "../../core/i18n:bundle",
    "../../core/sdk:bundle",
    "../../models/bindings:bundle",
    "../../models/computed_style:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
    "../../ui/visual_logging:bundle",
    "../elements:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "style_intelligence.ts"

  deps = [
    ":css_files",
    ":style_intelligence",
  ]

  visibility = [
    ":*",
    "../../entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "style_intelligence-meta.ts"

  deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]

  visibility = [ "../../entrypoints/*" ]
}

devtools_ui_module("unittests") {
  testonly = true

  sources = [
    "Diagnostics.test.ts",
    "ElementSummary.test.ts",
    "LayeringPresentation.test.ts",
    "LayoutExplanation.test.ts",
    "LayoutRelationships.test.ts",
    "LayoutRelationshipsPresentation.test.ts",
    "Presentation.test.ts",
    "SpacingExplanation.test.ts",
    "StackingBoundary.test.ts",
    "StackingChain.test.ts",
    "StackingReasons.test.ts",
  ]

  deps = [ ":bundle" ]
}
