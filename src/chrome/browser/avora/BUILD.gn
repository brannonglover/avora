# ── Avora's own test binaries ────────────────────────────────────────────────
#
# Avora's tests deliberately do NOT go into Chromium's monolithic unit_tests
# and browser_tests targets: those are declared in //chrome/test/BUILD.gn, a
# ~7k-line upstream file that Avora would then have to carry in the overlay
# and re-merge on every Chromium roll for the sake of a handful of source
# entries.
#
# Instead each directory keeps a source_set of its own tests next to the code
# under test -- the same shape Chromium uses -- and the two aggregate test()
# targets below, which Avora owns outright, link them against the standard
# harnesses.  Adding a test file means editing one Avora-owned source_set.
#
# Unit tests and browser tests are separate binaries because their harnesses
# are: unit tests link //chrome/test:test_support_unit, whose
# run_all_unittests.cc main runs in-process, while browser tests link
# //chrome/test:browser_tests_runner and spin up a real browser per test.
#
#   autoninja -C out/Default avora_unit_tests avora_browser_tests
#   out/Default/avora_unit_tests
#   out/Default/avora_browser_tests

import("//testing/test.gni")

source_set("unit_tests") {
  testonly = true

  sources = [
    "avora_import_provenance_unittest.cc",
    "avora_imported_link_store_unittest.cc",
    "avora_pinned_folders_unittest.cc",
    "avora_pinned_items_unittest.cc",
    "avora_space_icons_unittest.cc",
  ]

  deps = [
    ":avora",
    "//base",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//testing/gtest",
  ]
}

test("avora_unit_tests") {
  deps = [
    ":unit_tests",
    "//chrome/browser/avora/import:unit_tests",
    "//chrome/browser/ui/views/avora:unit_tests",
    "//chrome/test:test_support_unit",
    "//testing/gtest",
  ]
}

test("avora_browser_tests") {
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  deps = [
    "//chrome/browser/ui/views/avora:browser_tests",
    "//chrome/test:browser_tests_runner",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//testing/gtest",
  ]

  data_deps = [
    "//chrome:chrome",
    "//chrome/browser/resources:resources",
  ]
}

# Regression guard for SecondaryContentsMode.  Runs Chromium's own
# MultiContentsView browser tests, unmodified and straight from the Chromium
# tree, so that split view is verified by upstream's expectations rather than
# by anything Avora wrote about it.  A separate target from
# avora_browser_tests: these are not Avora's tests, and keeping them apart
# means an upstream test that stops compiling after a roll cannot block
# Avora's own suite from building.
test("avora_split_view_regression_tests") {
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "//chrome/browser/ui/views/frame/multi_contents_view_browsertest.cc" ]

  deps = [
    "//chrome/browser/ui/views/tabs/common",
    "//chrome/test:browser_tests_runner",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//testing/gtest",
  ]
}
