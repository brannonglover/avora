# Avora view unit tests.  Run by //chrome/browser/avora:avora_unit_tests.
source_set("unit_tests") {
  testonly = true

  sources = [ "avora_pinned_item_materializer_unittest.cc" ]

  deps = [
    ":avora",
    "//base",
    "//base/test:test_support",
    "//chrome/browser/avora",
    "//chrome/test:test_support",
    "//testing/gtest",
  ]
}

# Avora browser tests.  Run by //chrome/browser/avora:avora_browser_tests.
