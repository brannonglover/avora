{
  "name": "avora",
  "version": "1.2.1",
  "private": true,
  "description": "A Chromium-based browser with vertical tabs and spaces.",
  "scripts": {
    "build": "bash build-scripts/incremental-build.sh",
    "build:full": "bash build-scripts/build.sh full",
    "build:gen": "bash build-scripts/build.sh gen",
    "start": "open chromium/src/out/Default/Avora.app",
    "cleanup": "bash build-scripts/build.sh cleanup",
    "release": "bash build-scripts/release.sh",
    "site": "npm --prefix website run dev",
    "site:dmg": "npm --prefix website run dmg"
  }
}
