is_debug = false
is_component_build = false
symbol_level = 0
target_cpu = "arm64"
blink_symbol_level = 0
dcheck_always_on = false

# Enable H.264/AAC/MP3 decoding.  Without these, sites that serve
# proprietary-codec media (Instagram reels, Twitter/X video, many news
# players) fail with "trouble playing this video".
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Suppress "Google API keys are missing" infobar.  The API key is set to
# a dummy value so the infobar doesn't appear.  The OAuth client ID and
# secret are intentionally left unset (defaulting to "dummytoken") so
# that Chromium's DICE account-consistency system is disabled — otherwise
# Google's sign-in flow returns browser-level tokens instead of setting
# the traditional .google.com domain cookies (SID, SSID, etc.), and
# those token exchanges fail without real credentials.
google_api_key = "no"
