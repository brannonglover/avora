+    base::RepeatingCallback<void(int)> on_toggle,
+    base::RepeatingCallback<void(int, const gfx::Point&)> on_context,
+    base::RepeatingCallback<void(int, const std::string&)> on_rename)
+    : folder_index_(folder_index),
