+void TabStripView::ShowDragGhost(const gfx::Point& screen_point,
+                                 const std::u16string& title) {
+  if (!drag_ghost_view_) {
+    auto ghost = std::make_unique<views::View>();
+    ghost->SetPaintToLayer();
+    ghost->layer()->SetFillsBoundsOpaquely(false);
+    ghost->layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(6));
+    ghost->SetBackground(views::CreateRoundedRectBackground(
+        SkColorSetARGB(0xCC, 0x2A, 0x2D, 0x35), 6));
+    auto* ghost_layout =
+        ghost->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal,
+            gfx::Insets::VH(0, 12), 8));
+    ghost_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto label = std::make_unique<views::Label>(
+        title,
+        views::Label::CustomFont{gfx::FontList({std::string("system-ui")},
+                                                gfx::Font::NORMAL, 12,
+                                                gfx::Font::Weight::NORMAL)});
+    label->SetEnabledColor(SkColorSetARGB(0xDD, 0xED, 0xF2, 0xF5));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetElideBehavior(gfx::ELIDE_TAIL);
+    ghost->AddChildView(std::move(label));
+
+    // Add the ghost to the widget's root view so it paints above
+    // everything and is not clipped by any scroll view.
+    views::Widget* widget = GetWidget();
+    if (widget && widget->GetRootView()) {
+      drag_ghost_view_ =
+          widget->GetRootView()->AddChildView(std::move(ghost));
+    } else {
+      drag_ghost_view_ = AddChildView(std::move(ghost));
+    }
+  }
+
+  // Position the ghost in screen coordinates converted to the root view.
+  views::View* parent = drag_ghost_view_->parent();
+  gfx::Point local_point = screen_point;
+  views::View::ConvertPointFromScreen(parent, &local_point);
+
+  // Align horizontally with the tab strip.
+  gfx::Point strip_origin(0, 0);
+  views::View::ConvertPointToTarget(this, parent, &strip_origin);
+
+  int y = local_point.y() - 14;
+  drag_ghost_view_->SetBounds(strip_origin.x(), y, width(), 28);
+  drag_ghost_view_->SetVisible(true);
+}
+
+void TabStripView::HideDragGhost() {
+  if (drag_ghost_view_) {
+    drag_ghost_view_->SetVisible(false);
+  }
+}
