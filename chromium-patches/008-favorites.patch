+void FavoriteButton::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (on_context_) {
+    on_context_.Run(url_, point);
+  }
