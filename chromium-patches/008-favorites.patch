+// Avora: A 1px separator that fades to transparent at both ends.
+class FadingSeparator : public views::Separator {
+  METADATA_HEADER(FadingSeparator, views::Separator)
+
+ public:
+  FadingSeparator() = default;
+  ~FadingSeparator() override = default;
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::Rect bounds = GetContentsBounds();
+    if (bounds.IsEmpty()) {
+      return;
+    }
+
+    const SkColor4f color =
+        SkColor4f::FromColor(GetColorProvider()->GetColor(GetColorId()));
+    const SkColor4f transparent = {color.fR, color.fG, color.fB, 0.0f};
+
+    const SkScalar fade_fraction = 0.20f;
+    const SkPoint pts[] = {
+        SkPoint::Make(bounds.x(), 0),
+        SkPoint::Make(bounds.right(), 0),
+    };
+    const SkColor4f colors[] = {transparent, color, color, transparent};
+    const SkScalar positions[] = {0.0f, fade_fraction,
+                                  1.0f - fade_fraction, 1.0f};
+
+    cc::PaintFlags flags;
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        pts, colors, positions, 4, SkTileMode::kClamp));
+    flags.setAntiAlias(true);
+
+    canvas->DrawRect(gfx::RectF(bounds), flags);
+  }
+};
+
