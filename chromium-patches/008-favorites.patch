+void BrowserView::UpdateAvoraSidebarURL() {
+  if (!avora_sidebar_header_) {
+    return;
+  }
+  content::WebContents* contents = GetActiveWebContents();
+  if (!contents) {
+    avora_sidebar_header_->SetURL(u"");
+    avora_sidebar_header_->UpdateNavState(false, false);
+    return;
+  }
+
+  avora_sidebar_header_->UpdateNavState(
+      contents->GetController().CanGoBack(),
+      contents->GetController().CanGoForward());
+
+  const GURL& url = contents->GetVisibleURL();
+  if (!url.is_valid() || url.IsAboutBlank() ||
+      url.SchemeIs("chrome") || url.SchemeIs("chrome-native")) {
+    avora_sidebar_header_->SetURL(u"");
+    return;
+  }
+  std::string host{url.host()};
+  if (!host.empty() && host.substr(0, 4) == "www.") {
+    host = host.substr(4);
+  }
+  avora_sidebar_header_->SetURL(base::UTF8ToUTF16(host));
+}
