+void BrowserView::NavigateAvoraAddressBar(const std::u16string& text,
+                                          bool new_tab) {
+  std::string input = base::UTF16ToUTF8(text);
+
+  // Determine whether the input looks like a URL or a search query.
+  // FixupURL aggressively prepends http:// and percent-encodes spaces,
+  // turning plain search queries into bogus URLs.  Use simple heuristics
+  // that match what users expect:
+  //   - Contains a space           → search  (URLs never have bare spaces)
+  //   - Starts with a scheme       → URL
+  //   - Contains a dot and no space → URL  (e.g. "example.com")
+  //   - Single word like "localhost" or an IP → URL
+  //   - Everything else            → search
+  bool looks_like_url = false;
+  if (input.find(' ') == std::string::npos) {
+    // No spaces — could be a URL.
+    if (input.find("://") != std::string::npos) {
+      looks_like_url = true;
+    } else if (input.find('.') != std::string::npos) {
+      looks_like_url = true;
+    } else if (input == "localhost" ||
+               base::StartsWith(input, "localhost:",
+                                base::CompareCase::INSENSITIVE_ASCII)) {
+      looks_like_url = true;
+    }
+  }
+
+  GURL url;
+  if (looks_like_url) {
+    url = url_formatter::FixupURL(input, std::string());
+    if (!url.is_valid() ||
+        (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIs("chrome"))) {
+      looks_like_url = false;
+    }
+  }
+
+  if (!looks_like_url) {
+    avora::SearchEngineManager engine_mgr(
+        browser_->GetProfile()->GetPrefs());
+    url = GURL(engine_mgr.BuildSearchURL(input));
+  }
+
+  NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+  params.disposition = new_tab ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                               : WindowOpenDisposition::CURRENT_TAB;
+  Navigate(&params);
+}
+
+void BrowserView::ShowAvoraQuickNav() {
+  if (!avora_quick_nav_) {
+    return;
+  }
+
+  // Capture the current tab's URL before anything changes — useful for the
+  // history list even though the overlay is for a "new tab" action.
+  std::string current_url;
+  content::WebContents* contents = GetActiveWebContents();
+  if (contents) {
+    const GURL& url = contents->GetVisibleURL();
+    if (url.is_valid() && !url.IsAboutBlank() &&
+        !url.SchemeIs("chrome") && !url.SchemeIs("chrome-native")) {
+      current_url = url.spec();
+    }
+  }
+
+  // Show the overlay immediately — don't wait for a new tab or page load.
+  // The layout system positions the overlay from layout params, but set
+  // initial bounds here so it's correct before the next layout pass.
+  avora_quick_nav_->SetBoundsRect(
+      multi_contents_view_ ? multi_contents_view_->bounds()
+                           : GetLocalBounds());
+  avora_quick_nav_->Show(current_url);
+  ReorderChildView(avora_quick_nav_, children().size());
+
+  // Trigger a layout pass so the overlay gets its authoritative bounds
+  // computed from the layout parameters (independent of multi_contents_view).
+  DeprecatedLayoutImmediately();
+}
+
+void BrowserView::ShowAvoraQuickNavWithURL() {
+  if (!avora_quick_nav_) {
+    return;
+  }
+
+  std::u16string url_text;
+  std::string current_url;
+  content::WebContents* contents = GetActiveWebContents();
+  if (contents) {
+    const GURL& url = contents->GetVisibleURL();
+    if (url.is_valid() && !url.IsAboutBlank() &&
+        !url.SchemeIs("chrome") && !url.SchemeIs("chrome-native")) {
+      url_text = url_formatter::FormatUrl(
+          url, url_formatter::kFormatUrlOmitDefaults,
+          base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+      current_url = url.spec();
+    }
+  }
+
+  // Show the overlay immediately — initial bounds will be refined by the
+  // layout pass below.
+  avora_quick_nav_->SetBoundsRect(
+      multi_contents_view_ ? multi_contents_view_->bounds()
+                           : GetLocalBounds());
+  avora_quick_nav_->ShowWithURL(url_text, current_url);
+  ReorderChildView(avora_quick_nav_, children().size());
+
+  // Trigger a layout pass so the overlay gets its authoritative bounds
+  // computed from the layout parameters (independent of multi_contents_view).
+  DeprecatedLayoutImmediately();
+}
+
+void BrowserView::HideAvoraQuickNav() {
+  if (!avora_quick_nav_) {
+    return;
+  }
+  avora_quick_nav_->Hide();
+}
+
+void BrowserView::ShowAvoraLinkPreview(const GURL& url) {
+  if (!avora_link_preview_) {
+    return;
+  }
+  avora_link_preview_->SetBoundsRect(
+      multi_contents_view_ ? multi_contents_view_->bounds()
+                           : GetLocalBounds());
+  avora_link_preview_->Show(url);
+  ReorderChildView(avora_link_preview_, children().size());
+  DeprecatedLayoutImmediately();
+}
+
+void BrowserView::ShowAvoraLinkPreviewWithContents(
+    std::unique_ptr<content::WebContents> contents,
+    const GURL& url) {
+  if (!avora_link_preview_) {
+    return;
+  }
+  avora_link_preview_->SetBoundsRect(
+      multi_contents_view_ ? multi_contents_view_->bounds()
+                           : GetLocalBounds());
+  avora_link_preview_->ShowWithContents(std::move(contents), url);
+  ReorderChildView(avora_link_preview_, children().size());
+  DeprecatedLayoutImmediately();
+}
+
+void BrowserView::HideAvoraLinkPreview() {
+  if (!avora_link_preview_) {
+    return;
+  }
+  avora_link_preview_->Hide();
+}
+
+void BrowserView::OnLinkPreviewOpenInNewTab(const GURL& url) {
+  if (!url.is_valid()) {
+    return;
+  }
+  NavigateParams params(browser(), url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+}
+
+bool BrowserView::IsAvoraLinkPreviewShowing() const {
+  return avora_link_preview_ && avora_link_preview_->IsShowing();
+}
