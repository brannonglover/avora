+      : on_remove_(std::move(on_remove)) {}
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (command_id == kContextMenuRemoveId && on_remove_) {
+      std::move(on_remove_).Run();
+    }
+  }
+
+ private:
+  base::OnceClosure on_remove_;
+};
