+// Copyright 2026 Avora. All rights reserved.
+
+#ifndef CHROME_BROWSER_AVORA_AVORA_PINNED_FOLDERS_H_
+#define CHROME_BROWSER_AVORA_AVORA_PINNED_FOLDERS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "components/prefs/pref_service.h"
+
+class PrefRegistrySimple;
+
+namespace avora {
+
+struct FolderTab {
+  std::string url;
+  std::string title;
+};
+
+struct PinnedFolder {
+  std::string name;
+  bool expanded = true;
+  std::vector<FolderTab> tabs;
+};
+
+// Manages a list of pinned tab folders persisted via PrefService.
+// Each folder contains an ordered list of tab URLs and titles.
+class PinnedFoldersManager {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnPinnedFoldersChanged() = 0;
+  };
+
+  static constexpr char kPinnedFoldersPref[] = "avora.pinned_folders";
+  static constexpr char kPinnedTabTitlesPref[] = "avora.pinned_tab_titles";
+
+  explicit PinnedFoldersManager(PrefService* prefs);
+  ~PinnedFoldersManager();
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  std::vector<PinnedFolder> GetFolders() const;
+  void AddFolder(const std::string& name);
+  void RemoveFolder(int index);
+  void RenameFolder(int index, const std::string& name);
+  void AddTabToFolder(int folder_index,
+                      const std::string& url,
+                      const std::string& title);
+  void RemoveTabFromFolder(int folder_index, const std::string& url);
+  void MoveTabToFolder(const std::string& url,
+                       const std::string& title,
+                       int folder_index);
+  int GetFolderIndexForTab(const std::string& url) const;
+  void SetFolderExpanded(int index, bool expanded);
+
+  // Custom display titles for pinned tabs (keyed by URL).
+  std::string GetCustomTabTitle(const std::string& url) const;
+  void SetCustomTabTitle(const std::string& url, const std::string& title);
+  void ClearCustomTabTitle(const std::string& url);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  void RemoveTabFromAllFolders(const std::string& url);
+  void NotifyChanged();
+
+  raw_ptr<PrefService> prefs_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace avora
+
+#endif  // CHROME_BROWSER_AVORA_AVORA_PINNED_FOLDERS_H_
diff --git a/chrome/browser/avora/avora_pinned_folders.cc b/chrome/browser/avora/avora_pinned_folders.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/avora/avora_pinned_folders.cc
@@ -0,0 +1,     247 @@
+// Copyright 2026 Avora. All rights reserved.
+
+#include "chrome/browser/avora/avora_pinned_folders.h"
+
+#include <algorithm>
+
+#include "base/json/values_util.h"
+#include "base/values.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace avora {
+
+PinnedFoldersManager::PinnedFoldersManager(PrefService* prefs)
+    : prefs_(prefs) {}
+PinnedFoldersManager::~PinnedFoldersManager() = default;
+
+// static
+void PinnedFoldersManager::RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kPinnedFoldersPref);
+  registry->RegisterDictionaryPref(kPinnedTabTitlesPref);
+}
+
+std::vector<PinnedFolder> PinnedFoldersManager::GetFolders() const {
+  const base::ListValue& list = prefs_->GetList(kPinnedFoldersPref);
+  std::vector<PinnedFolder> result;
+  for (const auto& val : list) {
+    if (!val.is_dict()) {
+      continue;
+    }
+    const auto& dict = val.GetDict();
+    PinnedFolder folder;
+    const std::string* name = dict.FindString("name");
+    folder.name = name ? *name : "Untitled";
+    folder.expanded = dict.FindBool("expanded").value_or(true);
+    const auto* tabs = dict.FindList("tabs");
+    if (tabs) {
+      for (const auto& tab_val : *tabs) {
+        if (!tab_val.is_dict()) {
+          continue;
+        }
+        const auto& tab_dict = tab_val.GetDict();
+        const std::string* url = tab_dict.FindString("url");
+        const std::string* title = tab_dict.FindString("title");
+        if (url) {
+          folder.tabs.push_back({*url, title ? *title : std::string()});
+        }
+      }
+    }
+    result.push_back(std::move(folder));
+  }
+  return result;
+}
+
+void PinnedFoldersManager::AddFolder(const std::string& name) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  base::DictValue entry;
+  entry.Set("name", name);
+  entry.Set("expanded", true);
+  entry.Set("tabs", base::ListValue());
+  update->Append(std::move(entry));
+  NotifyChanged();
+}
+
+void PinnedFoldersManager::RemoveFolder(int index) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  if (index >= 0 && index < static_cast<int>(update->size())) {
+    update->erase(update->begin() + index);
+    NotifyChanged();
+  }
+}
+
+void PinnedFoldersManager::RenameFolder(int index, const std::string& name) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  if (index >= 0 && index < static_cast<int>(update->size())) {
+    (*update)[index].GetDict().Set("name", name);
+    NotifyChanged();
+  }
+}
+
+void PinnedFoldersManager::AddTabToFolder(int folder_index,
+                                          const std::string& url,
+                                          const std::string& title) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  if (folder_index < 0 ||
+      folder_index >= static_cast<int>(update->size())) {
+    return;
+  }
+  auto* tabs = (*update)[folder_index].GetDict().FindList("tabs");
+  if (!tabs) {
+    return;
+  }
+  // Avoid duplicates within this folder.
+  for (const auto& t : *tabs) {
+    if (t.is_dict()) {
+      const std::string* existing = t.GetDict().FindString("url");
+      if (existing && *existing == url) {
+        return;
+      }
+    }
+  }
+  base::DictValue tab_entry;
+  tab_entry.Set("url", url);
+  tab_entry.Set("title", title);
+  tabs->Append(std::move(tab_entry));
+  NotifyChanged();
+}
+
+void PinnedFoldersManager::RemoveTabFromFolder(int folder_index,
+                                               const std::string& url) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  if (folder_index < 0 ||
+      folder_index >= static_cast<int>(update->size())) {
+    return;
+  }
+  auto* tabs = (*update)[folder_index].GetDict().FindList("tabs");
+  if (tabs) {
+    tabs->EraseIf([&url](const base::Value& val) {
+      if (!val.is_dict()) {
+        return false;
+      }
+      const std::string* stored = val.GetDict().FindString("url");
+      return stored && *stored == url;
+    });
+  }
+  NotifyChanged();
+}
+
+void PinnedFoldersManager::RemoveTabFromAllFolders(const std::string& url) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  for (auto& val : *update) {
+    if (!val.is_dict()) {
+      continue;
+    }
+    auto* tabs = val.GetDict().FindList("tabs");
+    if (tabs) {
+      tabs->EraseIf([&url](const base::Value& v) {
+        if (!v.is_dict()) {
+          return false;
+        }
+        const std::string* stored = v.GetDict().FindString("url");
+        return stored && *stored == url;
+      });
+    }
+  }
+}
+
+void PinnedFoldersManager::MoveTabToFolder(const std::string& url,
+                                           const std::string& title,
+                                           int folder_index) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  // Remove from all folders first.
+  for (auto& val : *update) {
+    if (!val.is_dict()) {
+      continue;
+    }
+    auto* tabs = val.GetDict().FindList("tabs");
+    if (tabs) {
+      tabs->EraseIf([&url](const base::Value& v) {
+        if (!v.is_dict()) {
+          return false;
+        }
+        const std::string* stored = v.GetDict().FindString("url");
+        return stored && *stored == url;
+      });
+    }
+  }
+  // Add to the target folder.
+  if (folder_index >= 0 &&
+      folder_index < static_cast<int>(update->size())) {
+    auto* tabs = (*update)[folder_index].GetDict().FindList("tabs");
+    if (tabs) {
+      base::DictValue tab_entry;
+      tab_entry.Set("url", url);
+      tab_entry.Set("title", title);
+      tabs->Append(std::move(tab_entry));
+    }
+  }
+  NotifyChanged();
+}
+
+int PinnedFoldersManager::GetFolderIndexForTab(
+    const std::string& url) const {
+  const base::ListValue& list = prefs_->GetList(kPinnedFoldersPref);
+  for (int i = 0; i < static_cast<int>(list.size()); ++i) {
+    if (!list[i].is_dict()) {
+      continue;
+    }
+    const auto* tabs = list[i].GetDict().FindList("tabs");
+    if (!tabs) {
+      continue;
+    }
+    for (const auto& t : *tabs) {
+      if (t.is_dict()) {
+        const std::string* stored = t.GetDict().FindString("url");
+        if (stored && *stored == url) {
+          return i;
+        }
+      }
+    }
+  }
+  return -1;
+}
+
+void PinnedFoldersManager::SetFolderExpanded(int index, bool expanded) {
+  ScopedListPrefUpdate update(prefs_, kPinnedFoldersPref);
+  if (index >= 0 && index < static_cast<int>(update->size())) {
+    (*update)[index].GetDict().Set("expanded", expanded);
+    NotifyChanged();
+  }
+}
+
+std::string PinnedFoldersManager::GetCustomTabTitle(
+    const std::string& url) const {
+  const auto& dict = prefs_->GetDict(kPinnedTabTitlesPref);
+  const std::string* title = dict.FindString(url);
+  return title ? *title : std::string();
+}
+
+void PinnedFoldersManager::SetCustomTabTitle(const std::string& url,
+                                             const std::string& title) {
+  ScopedDictPrefUpdate update(prefs_, kPinnedTabTitlesPref);
+  update->Set(url, title);
+  NotifyChanged();
+}
+
+void PinnedFoldersManager::ClearCustomTabTitle(const std::string& url) {
+  ScopedDictPrefUpdate update(prefs_, kPinnedTabTitlesPref);
+  update->Remove(url);
+  NotifyChanged();
+}
+
+void PinnedFoldersManager::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PinnedFoldersManager::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void PinnedFoldersManager::NotifyChanged() {
+  for (auto& observer : observers_) {
+    observer.OnPinnedFoldersChanged();
+  }
+}
+
+}  // namespace avora
