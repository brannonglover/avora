@@ -21,6 +21,7 @@
 #include "ui/base/theme_provider.h"
 #include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
 #include "ui/gfx/geometry/skia_conversions.h"
 #include "ui/gfx/scoped_canvas.h"
 #include "ui/views/view_utils.h"
@@ -89,6 +90,32 @@ void VerticalTabStyleViews::PaintTab(gfx::Canvas* canvas) const {
     PaintTabBackgroundFill(canvas, GetSelectionState(),
                            delegate_->IsHoverAnimationActive(), std::nullopt);
   }
+
+  // Avora: paint a left-edge accent indicator on the active tab so
+  // the user can immediately see which tab is current.
+  if (GetSelectionState() == TabStyle::TabSelectionState::kActive) {
+    PaintActiveIndicator(canvas);
+  }
+}
+
+void VerticalTabStyleViews::PaintActiveIndicator(gfx::Canvas* canvas) const {
+  constexpr SkColor kAvoraAccent = SkColorSetRGB(0x6E, 0xA1, 0xF7);
+  constexpr int kIndicatorWidth = 4;
+  constexpr int kIndicatorVerticalInset = 10;
+  constexpr SkScalar kIndicatorCornerRadius = 2.0f;
+
+  gfx::Rect bounds = delegate_->GetView()->GetLocalBounds();
+  gfx::RectF indicator_rect(
+      bounds.x(), bounds.y() + kIndicatorVerticalInset,
+      kIndicatorWidth,
+      bounds.height() - 2 * kIndicatorVerticalInset);
+
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const float scale = canvas->UndoDeviceScaleFactor();
+  indicator_rect.Scale(scale);
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(kAvoraAccent);
+  canvas->DrawRoundRect(indicator_rect, kIndicatorCornerRadius * scale, flags);
 }
 
