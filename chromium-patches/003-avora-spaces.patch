@@ -0,0 +1,62 @@
+// Copyright 2026 Avora. All rights reserved.
+
+#ifndef CHROME_BROWSER_AVORA_AVORA_SPACE_MANAGER_H_
+#define CHROME_BROWSER_AVORA_AVORA_SPACE_MANAGER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/avora/avora_space.h"
+
+class PrefService;
+class PrefRegistrySimple;
+
+namespace avora {
+
+// Manages Avora Spaces -- named workspaces that group tabs.
+// Each space stores its own set of pinned URLs.
+// Persists to Chrome's PrefService so spaces survive across restarts.
+class SpaceManager {
+ public:
+  static constexpr char kSpacesPref[] = "avora.spaces";
+
+  explicit SpaceManager(PrefService* pref_service);
+  ~SpaceManager();
+
+  static void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+  // Returns all spaces.
+  std::vector<Space> GetSpaces() const;
+
+  // Returns the currently active space, or nullptr if none.
+  const Space* GetActiveSpace() const;
+
+  // Creates a new space with the given name and returns its ID.
+  std::string CreateSpace(const std::string& name);
+
+  // Removes the space with the given ID.
+  void RemoveSpace(const std::string& id);
+
+  // Switches to the space with the given ID.
+  void ActivateSpace(const std::string& id);
+
+  // Renames a space.
+  void RenameSpace(const std::string& id, const std::string& new_name);
+
+  // Adds a pinned URL to a space.
+  void AddPinnedUrl(const std::string& space_id, const std::string& url);
+
+  // Removes a pinned URL from a space.
+  void RemovePinnedUrl(const std::string& space_id, const std::string& url);
+
+ private:
+  void SaveSpaces(const std::vector<Space>& spaces);
+
+  raw_ptr<PrefService> pref_service_;
+};
+
+}  // namespace avora
+
+#endif  // CHROME_BROWSER_AVORA_AVORA_SPACE_MANAGER_H_
