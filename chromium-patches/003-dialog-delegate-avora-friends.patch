Allow Avora's import dialogs to subclass views::DialogDelegateView.

DialogDelegateView's default constructor is private and its DdvPassKey
cannot be minted outside the class, so a subclass must appear in the
friend list. AvoraImportDialogView and AvoraImportOfferView both derive
from it, so both are declared here. Note the friend declarations must be
namespace-qualified (::avora::...) -- an unqualified ::Name refers to a
different, non-existent global type and silently fails to grant access.

diff --git a/ui/views/window/dialog_delegate.h b/ui/views/window/dialog_delegate.h
--- a/ui/views/window/dialog_delegate.h
+++ b/ui/views/window/dialog_delegate.h
@@ -30,6 +30,12 @@
 
 class AppInfoDialogViewsTest;
 class AuthenticatorRequestDialogView;
+
+namespace avora {
+class AvoraImportDialogView;
+class AvoraImportOfferView;
+}  // namespace avora
+
 class BatchUploadDialogView;
 class BluetoothDeviceCredentialsView;
 class BluetoothDevicePairConfirmView;
@@ -710,6 +716,8 @@
   // DO NOT ADD TO THIS LIST!
   // These existing cases are "grandfathered in", but there shouldn't be more.
   // See comments atop class.
+  friend class ::avora::AvoraImportDialogView;
+  friend class ::avora::AvoraImportOfferView;
   friend class ::AppInfoDialogViewsTest;
   friend class ::AuthenticatorRequestDialogView;
   friend class ::BatchUploadDialogView;
